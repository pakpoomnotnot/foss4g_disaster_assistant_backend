# LLM — any OpenAI-compatible /chat/completions endpoint.
# LLM_BASE_URL must include the version segment (".../v1"); the client appends
# /chat/completions and /models itself. The endpoint has to support
# response_format={"type":"json_object"} — that is what keeps the model from
# wrapping the query object in prose.
# Leave LLM_API_KEY empty for a local server that needs no auth (e.g. Ollama's
# own OpenAI-compatible endpoint at http://localhost:11434/v1).
# For OpenRouter, LLM_API_KEY may stay empty when OPENROUTER_API_KEY is exported.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26b-a4b-it:free
# true sends OpenRouter's reasoning:{enabled:true} (slower; off by default)
LLM_REASONING=false

# GISTDA STAC Gateway
GISTDA_GATEWAY_HOST=https://api-gateway.gistda.or.th/api/2.0

# Preferred credential — a long-lived key, nothing to refresh (README.md §4.2).
GISTDA_API_KEY=

# Fallback only, used when GISTDA_API_KEY is empty. Expires ~1 hour after it is
# issued, so it has to be pasted in again by hand every time.
GISTDA_ACCESS_TOKEN=

# Phase 2 (see backend/README.md §4.3): guest account for auto password-grant + refresh flow
# Not available yet — request from GISTDA before enabling
GISTDA_GUEST_USERNAME=
GISTDA_GUEST_PASSWORD=

# Gazetteer (see backend/README.md §5)
GAZETTEER_PATH=../foss4g_disaster_assistant_frontend/src/lib/gazetteer_merged.json

# Server
PORT=8080
RUST_LOG=info
